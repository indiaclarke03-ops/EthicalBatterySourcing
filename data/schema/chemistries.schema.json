{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "chemistries.schema.json",
 "title": "chemistries",
 "type": "object",
 "required": [
  "schema_version",
  "as_of",
  "items"
 ],
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "as_of": {
   "$ref": "common.json#/$defs/as_of"
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "short",
     "tier_of_depth",
     "passport_type",
     "summary",
     "use_cases"
    ],
    "properties": {
     "id": {
      "$ref": "common.json#/$defs/chemistry"
     },
     "name": {
      "type": "string"
     },
     "short": {
      "type": "string"
     },
     "tier_of_depth": {
      "enum": [
       "core",
       "reference",
       "extension"
      ]
     },
     "passport_type": {
      "enum": [
       "full",
       "reference",
       "shadow"
      ]
     },
     "case_companies": {
      "type": "array",
      "items": {
       "$ref": "common.json#/$defs/id"
      }
     },
     "summary": {
      "type": "string"
     },
     "research_note": {
      "type": "string"
     },
     "contributors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "name",
        "role"
       ],
       "properties": {
        "name": {
         "type": "string"
        },
        "role": {
         "type": "string"
        }
       }
      }
     },
     "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "use_case",
        "scope_status",
        "scope_basis",
        "shadow_passport",
        "values",
        "confidence",
        "confidence_reason"
       ],
       "properties": {
        "use_case": {
         "$ref": "common.json#/$defs/use_case"
        },
        "scope_status": {
         "$ref": "common.json#/$defs/scope_status"
        },
        "scope_basis": {
         "type": "string"
        },
        "shadow_passport": {
         "type": "boolean"
        },
        "values": {
         "type": "array",
         "minItems": 1,
         "items": {
          "$ref": "common.json#/$defs/claim"
         }
        },
        "confidence": {
         "$ref": "common.json#/$defs/confidence"
        },
        "confidence_reason": {
         "$ref": "common.json#/$defs/reason"
        }
       }
      }
     }
    }
   }
  }
 }
}